# Is file ko copy karke ".env" naam do:   cp .env.example .env
# Phir apni values yahin LOCALLY bharo. .env ko kabhi Git/chat me share mat karo.

# my.telegram.org -> API development tools se milta hai
API_ID=
API_HASH=

# Session file ka naam (workspace/sessions/ ke andar banegi)
SESSION_NAME=file_manager

# Channel ka exact naam (jaisa Telegram me dikhta hai)
CHANNEL_NAME=File Manager
# Optional: agar same naam ke kai channels hain to yahan channel ID daalo (e.g. -1001234567890)
CHANNEL_ID=

# Workspace folder (default: ./workspace)
WORKSPACE_DIR=workspace

# Safety limits
MAX_ARCHIVE_MB=2048
MAX_EXTRACTED_MB=4096
MAX_FILES=10000
MAX_COMPRESSION_RATIO=200
MIN_FREE_DISK_MB=500
